PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:4000
JWT_SECRET=change-me-to-a-long-random-string

# Supabase / PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zura

# GitHub OAuth App (login)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub App (bot)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Circle Developer-Controlled Wallets (console.circle.com)
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_SET_ID=
# SCA wallets are gas-sponsored by Circle Gas Station once a policy is enabled in the console
CIRCLE_ACCOUNT_TYPE=SCA
CIRCLE_BLOCKCHAIN=ARC-TESTNET
# Zura operator wallet (Circle wallet id) - calls distribute()/enableRefund()/badge mint
CIRCLE_OPERATOR_WALLET_ID=

# ARC
ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_CHAIN_ID=5042002
USDC_ADDRESS=0x3600000000000000000000000000000000000000
WAVE_FACTORY_ADDRESS=
WAVE_REGISTRY_ADDRESS=
REPUTATION_BADGE_ADDRESS=

# CCTP v2 (testnet)
CCTP_IRIS_API=https://iris-api-sandbox.circle.com
CCTP_TOKEN_MESSENGER_ARC=0x8FE6B999Dc680CcFDD5Bf7EB0974218be2542DAA
CCTP_MESSAGE_TRANSMITTER=0xE737e5cEBEEBa77EFE34D4aa090756590b1CE275
# Circle wallet ids that relay receiveMessage() on each destination chain
CIRCLE_RELAYER_WALLET_ETH_SEPOLIA=
CIRCLE_RELAYER_WALLET_BASE_SEPOLIA=

# Require approved KYC before withdrawals
KYC_REQUIRED=false
# Background worker: auto-settle ended Waves, advance CCTP withdrawals
WORKER_ENABLED=true
